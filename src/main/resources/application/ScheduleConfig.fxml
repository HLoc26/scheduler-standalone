<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controllers.ScheduleConfigController" xmlns="http://javafx.com/javafx/17"
      alignment="TOP_CENTER" prefHeight="250.0" prefWidth="450.0" spacing="10.0"
      style="-fx-background-color: white;">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="15.0">
        <Label text="Cấu hình Xếp lịch" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
        <Separator prefWidth="200.0"/>
    </VBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <GridPane hgap="20.0" vgap="20.0" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" percentWidth="40.0"/>
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="10.0" percentWidth="60.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Thời gian tối đa (giây):" textFill="#34495e" GridPane.rowIndex="0"
                       GridPane.columnIndex="0">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <Spinner fx:id="spnMaxTime" editable="true" maxWidth="Infinity" GridPane.rowIndex="0"
                         GridPane.columnIndex="1"/>

                <Label text="Số luồng xử lý (Workers):" textFill="#34495e" GridPane.rowIndex="1"
                       GridPane.columnIndex="0">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <Spinner fx:id="spnMaxWorkers" editable="true" maxWidth="Infinity" GridPane.rowIndex="1"
                         GridPane.columnIndex="1"/>
            </children>
        </GridPane>
    </VBox>

    <HBox alignment="BOTTOM_RIGHT" spacing="15.0">
        <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#handleCancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                text="Hủy bỏ">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>
        </Button>
        <Button fx:id="btnNext" mnemonicParsing="false" onAction="#handleNext"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                text="Tiếp tục">
            <padding>
                <Insets bottom="10.0" left="30.0" right="30.0" top="10.0"/>
            </padding>
        </Button>
    </HBox>

</VBox>